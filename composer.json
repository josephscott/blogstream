{
	"name": "josephscott/blogstream",
	"description": "SSE pings from blo.gs",
	"license": "MIT",
	"authors": [
		{
			"name": "Joseph Scott",
			"email": "joseph@josephscott.org"
		}
	],
	"require": {
		"php": ">=8.3",
		"ext-event": "^3.0.3",
		"workerman/workerman": "^5.1.1"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.75",
		"josephscott/phpcsfixer-config": "^0.0.4",
		"phpstan/phpstan": "^2.1.12",
		"pestphp/pest": "^3.8.2"
	},
	"config": {
		"classmap-authoritative": true,
		"optimize-autoloader": true,
		"allow-plugins": false
	}
}
